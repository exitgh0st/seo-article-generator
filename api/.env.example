# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
ORIGIN=http://localhost:4200

# Postgres. Port 5433 matches docker-compose.yml, which avoids colliding with a
# local Postgres on the default 5432.
DATABASE_URL=postgresql://seo:seo@localhost:5433/seo_articles?schema=public

# Auth. Generate the hash with: npm run hash:password -- "your-password"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD_HASH=

# Where published markdown is exported. Relative paths resolve from api/.
CONTENT_DIR=../content

# Where the Angular SSR server finds this API. Set on the app process, not here.
# API_URL=http://localhost:3000

# Public site origin, used for canonical URLs, sitemap.xml and rss.xml.
SITE_ORIGIN=http://localhost:4200

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# DeepSeek drives the generation stages (OpenAI-compatible wire format).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Web search for the research stage — https://app.tavily.com
TAVILY_API_KEY=

# Editorial documents, read at boot. Relative paths resolve from api/.
DOCS_DIR=../docs
